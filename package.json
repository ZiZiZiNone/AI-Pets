{
  "name": "ai-pets",
  "private": true,
  "version": "2.1.0",
  "description": "AI-Pets — multi-format (2D/Live2D/Spine/VRM) micro-kernel desktop pet host built with Tauri v2, Vue 3, PixiJS, and Three.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --features custom-protocol",
    "scan:dead": "node scripts/dead-code-scan.mjs",
    "scan:cycles": "node scripts/cycle-scan.mjs",
    "verify": "node scripts/verify.mjs",
    "release:check": "python scripts/release-check.py",
    "build": "npm run typecheck && npm run scan:dead && npm run scan:cycles && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.1.0",
    "@pixiv/three-vrm-animation": "^3.1.0",
    "@tauri-apps/api": "^2.0.0",
    "js-yaml": "^4.1.0",
    "pinia": "^2.1.7",
    "pixi-live2d-display-lipsyncpatch": "^0.5.0-ls-8",
    "pixi-spine": "^4.0.4",
    "pixi.js": "^7.4.0",
    "three": "^0.167.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/three": "^0.167.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.26"
  }
}
